# xbps package of fili-ai (Lia), read by distro/build-repo.sh. The window is Qt Quick on the layer-shell (layer-shell-qt gives
# the surface), wl-clipboard pastes files and images, libnotify (notify-send) the notifications.
DESC="Lia, the optional AI assistant of Filigrane (Qt Quick, Rust)"
DEPENDS="glibc>=2.39_1 libgcc>=0 qt6-declarative>=0 qt6-wayland>=0 layer-shell-qt>=0 wl-clipboard>=0 libnotify>=0 bash>=0"
SHLIBS="libc.so.6 libgcc_s.so.1 libstdc++.so.6 libQt6Core.so.6 libQt6Gui.so.6 libQt6Qml.so.6"
PKG_LICENSE="GPL-3.0-or-later"
# The programs of the package (the launcher `fili-ai` is a script, installed by `make install-data`)
BINS="fili-ai-daemon fili-ai-session fili-ai-window"
